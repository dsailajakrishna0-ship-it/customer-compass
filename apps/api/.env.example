# Copy this file to apps/api/.env and fill in the values you need.
# apps/api/.env is gitignored — never commit real secrets.

# --- LLM provider selection (Stage 4) --------------------------------------
# "ollama" (default, local) or "cloud" (OpenRouter). Leaving this unset keeps
# the existing Stage 2/3 local-only behavior unchanged.
# LLM_PROVIDER=ollama

# --- Ollama (local, default) ------------------------------------------------
# OLLAMA_URL=http://localhost:11435
# OLLAMA_MODEL=qwen2.5:3b

# --- OpenRouter (cloud, opt-in via LLM_PROVIDER=cloud) ----------------------
# Get a free API key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Free-tier OpenRouter model slugs change often (they get promoted to
# paid-only or rate-limited). If this one stops working, list current free
# models with:
#   curl -s https://openrouter.ai/api/v1/models | python3 -c \
#     "import json,sys; print('\n'.join(m['id'] for m in json.load(sys.stdin)['data'] if m['id'].endswith(':free')))"
# then set OPENROUTER_MODEL to a working ":free" slug.

# --- Database ----------------------------------------------------------------
# DATABASE_URL=postgres://customer_compass:customer_compass_dev@localhost:5432/customer_compass
